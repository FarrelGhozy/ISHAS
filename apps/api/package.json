{
  "name": "ishas-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run --watch src/server.ts",
    "start": "bun run src/server.ts",
    "migrate": "bun run src/migrate.ts",
    "seed": "bun run src/seed/index.ts",
    "seed:demo": "bun run src/seed/index.ts --mode=demo",
    "seed:empty": "bun run src/seed/index.ts --mode=empty",
    "sweep": "bun run src/sweep.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint"
  },
  "dependencies": {
    "mysql2": "^3.14.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "oxlint": "^1.76.0",
    "typescript": "^5.9.3"
  }
}
