# =============================================================================
# ISHAS — Template environment (DI-COMMIT). Salin ke `.env` sekali:
#   cp .env.example .env
# -----------------------------------------------------------------------------
# Semua nilai yang dapat diubah ada di `.env` (terpusat), termasuk yang dipakai
# docker-compose. Jangan hardcode nilai di docker-compose.yml / Dockerfile /
# vite.config.ts — tambahkan variabel baru di sini dan di `.env`.
# Verifikasi interpolasi: `docker compose config`.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Compose & Port Host
# -----------------------------------------------------------------------------
# Profile Compose default. `dev` = hot-reload, `prod` = image nginx.
COMPOSE_PROFILES=dev

# Port host (yang dibuka di mesin Anda). Dev & prod memakai port host sama,
# jadi jalankan bergantian (hanya satu profile pada satu waktu).
WEB_PORT=3003
# Port host untuk backend Bun saat dijalankan lokal (`bun run dev`).
API_PORT=3004

# -----------------------------------------------------------------------------
# 2. Port Internal Container (yang di-listen di dalam container)
# -----------------------------------------------------------------------------
# Ubah hanya bila Anda tahu container/dev server memang listen di port ini.
WEB_DEV_CONTAINER_PORT=3003
WEB_PROD_CONTAINER_PORT=80

# -----------------------------------------------------------------------------
# 3. Image & Tag
# -----------------------------------------------------------------------------
# Pin versi penuh (mis. BUN_IMAGE_TAG=1.2.5) untuk build reproduksibel.
# Builder produksi memakai Node karena `react-router build` butuh ekspor Node.
BUN_IMAGE_TAG=1
NODE_IMAGE_TAG=22-slim
NGINX_IMAGE_TAG=alpine
MYSQL_IMAGE_TAG=8.4

# -----------------------------------------------------------------------------
# 4. Frontend (apps/web) — hanya var ber-prefix VITE_ yang diekspos ke klien
# -----------------------------------------------------------------------------
# Adapter backend. `false` = mock (default), `true` = HTTP.
# Saat `true`, login kartu dev memakai /auth/demo-login.
VITE_USE_BACKEND=false
# Basis URL API saat adapter aktif (default same-origin lewat proxy Vite).
VITE_API_BASE=/api/v1
# Tambahan host dev yang diizinkan (koma, mis. `VITE_ALLOWED_HOSTS=contoh.id`).
VITE_ALLOWED_HOSTS=
# Host backend yang dituju proxy Vite saat `bun run dev` dijalankan di HOST.
# Di dalam container Compose nilai ini di-override ke `host.docker.internal`
# oleh docker-compose.yml, jadi cukup `127.0.0.1` untuk pemakaian lokal.
API_PROXY_HOST=127.0.0.1

# -----------------------------------------------------------------------------
# 5. Backend (apps/api) + service `db` Compose (profile `api`)
# -----------------------------------------------------------------------------
# Nyalakan MySQL demo: `docker compose --profile api up -d db`
DB_HOST=127.0.0.1
# Port host MySQL (yang dibuka di mesin Anda). Port internal container tetap 3306.
DB_PORT=3306
DB_NAME=ishas
DB_USER=ishas
DB_PASSWORD=ishas
DB_ROOT_PASSWORD=root
# Direktori penyimpanan blob file. Kosongkan = default `<cwd>/storage`.
STORAGE_DIR=

# -----------------------------------------------------------------------------
# 6. Auth (Fase 6, development)
# -----------------------------------------------------------------------------
# Sandi awal akun seed / akun baru (prototipe; wajib diganti lewat /auth/password).
SEED_DEFAULT_PASSWORD=ishas-demo
# Masa berlaku sesi (ms); default 7 hari.
SESSION_TTL_MS=604800000
# Batas percobaan login per IP+email dalam satu jendela (default 5 per 60 detik).
LOGIN_RATE_LIMIT=5
LOGIN_RATE_WINDOW_MS=60000
