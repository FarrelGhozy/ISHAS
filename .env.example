# ISHAS — contoh environment untuk Docker Compose.
# Salin menjadi `.env` (sekali saja): `cp .env.example .env`
# File `.env` tidak di-commit (sudah tercakup `.gitignore`); ubah nilai di `.env` lokal.

# Port host untuk web dev maupun prod. Keduanya memakai port yang sama,
# sehingga hanya satu profile yang dijalankan dalam satu waktu.
WEB_PORT=3003

# Profile Compose default. Isi `dev` untuk hot-reload, `prod` untuk image nginx.
COMPOSE_PROFILES=dev

# Tag base image. Pin versi penuh (mis. BUN_IMAGE_TAG=1.2.5) bila perlu build yang reproduksibel.
# Builder produksi memakai Node karena react-router build memerlukan kondisi ekspor Node.
BUN_IMAGE_TAG=1
NODE_IMAGE_TAG=22-slim
NGINX_IMAGE_TAG=alpine

# Tambahan host dev yang diizinkan (koma, mis. `VITE_ALLOWED_HOSTS=contoh.id`).
# Dibaca `vite.config.ts` lokal maupun di container dev (via `env_file` Compose).
VITE_ALLOWED_HOSTS=

# Adapter backend frontend (issue #10). `false` = mock (default), `true` = HTTP.
# Saat `true`, login kartu dev memakai /auth/demo-login (Fase 6).
VITE_USE_BACKEND=false
# Basis URL API saat adapter aktif (default same-origin lewat proxy Vite).
VITE_API_BASE=/api/v1

# --- Backend (apps/api) + service `db` Compose (profile `api`) ---
# Nyalakan MySQL demo: `docker compose --profile api up -d db`
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=ishas
DB_USER=ishas
DB_PASSWORD=ishas
DB_ROOT_PASSWORD=root
# Port server backend lokal (Bun).
API_PORT=3004

# --- Auth Fase 6 (development) ---
# Sandi awal akun seed / akun baru (prototipe; wajib diganti lewat /auth/password).
SEED_DEFAULT_PASSWORD=ishas-demo
# Masa berlaku sesi (ms); default 7 hari.
SESSION_TTL_MS=604800000
# Batas percobaan login per IP+email dalam satu jendela (default 5 per 60 detik).
LOGIN_RATE_LIMIT=5
LOGIN_RATE_WINDOW_MS=60000
