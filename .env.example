# =============================================================================
# ISHAS — Template environment (file contoh, IKUT ter-commit ke Git).
# =============================================================================
#
#   SELAMAT DATANG. File ini adalah "buku panduan" semua pengaturan aplikasi.
#
#   Cara pakai untuk pemula:
#   1. Salin file ini menjadi `.env` (cukup sekali):
#          cp .env.example .env
#   2. Buka `.env`, ubah nilai yang perlu saja. Biarkan sisanya apa adanya.
#   3. File `.env` TIDAK ikut ter-commit (berisi rahasia), jadi aman.
#
#   Aturan umum:
#   - Format: NAMA=NILAI  (tanpa spasi di sekitar `=`, tanpa tanda kutip).
#   - Baris yang diawali `#` adalah komentar/penjelasan, diabaikan program.
#   - JANGAN mengubah nilai di dalam file kode (docker-compose.yml, Dockerfile,
#     dll). Semua pengaturan cukup diubah DI FILE INI saja.
#   - Setelah mengubah, cek tidak ada salah ketik dengan:
#          docker compose config
#
#   Bingung mulai dari mana? Untuk sekadar mencoba di komputer sendiri, Anda
#   TIDAK perlu mengubah apa pun. Cukup salin ke `.env` lalu jalankan sesuai
#   petunjuk di README.
#
# =============================================================================


# -----------------------------------------------------------------------------
# 1. MODE JALAN & PORT DI KOMPUTER ANDA
# -----------------------------------------------------------------------------
# Apa itu "port"? Seperti nomor pintu di alamat http://localhost:<port>.
# Kalau nomor ini bentrok dengan aplikasi lain, ganti ke angka lain (mis. 4000).

# Mode default saat menjalankan Docker Compose.
#   dev  = untuk ngoding (halaman otomatis ter-refresh saat kode diubah)
#   prod = untuk melihat hasil akhir (lebih ringan, seperti versi rilis)
# Pilihan: dev | prod      Contoh: COMPOSE_PROFILES=dev
COMPOSE_PROFILES=dev

# Nomor pintu untuk membuka aplikasi web di browser.
# Buka di browser: http://localhost:3003
# Contoh ganti bila bentrok: WEB_PORT=8080
WEB_PORT=3003

# Nomor pintu untuk server backend saat dijalankan langsung (tanpa Docker).
# Contoh: API_PORT=3004
API_PORT=3004


# -----------------------------------------------------------------------------
# 2. PORT DI DALAM CONTAINER (BIARKAN APA ADANYA kalau tidak yakin)
# -----------------------------------------------------------------------------
# Ini "pintu" di dalam wadah Docker, bukan pintu di komputer Anda. Nilai di
# bagian ini jarang perlu diubah. Ubah HANYA bila Anda memang tahu alasannya.

# Pintu aplikasi web di dalam wadah mode `dev`.
WEB_DEV_CONTAINER_PORT=3003

# Pintu aplikasi web di dalam wadah mode `prod` (nginx). Umumnya 80.
WEB_PROD_CONTAINER_PORT=80


# -----------------------------------------------------------------------------
# 3. VERSI GAMBAR (IMAGE) YANG DIPAKAI
# -----------------------------------------------------------------------------
# Ini menentukan versi software dasar yang diunduh otomatis.
# Tips: biarkan seperti ini untuk pemakaian biasa. Untuk hasil yang selalu sama
# persis (reproduksibel) di tim, ganti ke versi lengkap, mis. BUN_IMAGE_TAG=1.2.5

# Versi Bun (mesin JavaScript) untuk web & backend.
BUN_IMAGE_TAG=1
# Versi Node untuk proses build produksi web.
NODE_IMAGE_TAG=22-slim
# Versi Nginx (web server) untuk mode produksi.
NGINX_IMAGE_TAG=alpine
# Versi database MySQL. Contoh naik versi: MYSQL_IMAGE_TAG=8.4
MYSQL_IMAGE_TAG=8.4


# -----------------------------------------------------------------------------
# 4. FRONTEND / TAMPILAN WEB (apps/web)
# -----------------------------------------------------------------------------
# Catatan: hanya nilai yang diawali "VITE_" yang bisa dibaca oleh tampilan.

# Sumber data aplikasi:
#   false = memakai data CONTOH (mock)  -> cocok untuk coba-coba tanpa server
#   true  = memakai data dari server    -> butuh backend + database menyala
# Pilihan: false | true
VITE_USE_BACKEND=false

# Alamat dasar API. Untuk pemakaian biasa biarkan seperti ini.
VITE_API_BASE=/api/v1

# Daftar nama domain tambahan yang boleh membuka aplikasi (dipisah koma).
# Kosongkan bila hanya mengakses lewat localhost.
# Contoh: VITE_ALLOWED_HOSTS=ishas.utc.web.id,.ishas.utc.web.id
VITE_ALLOWED_HOSTS=

# Alamat server backend yang dituju saat menjalankan web langsung di komputer.
# Biasanya 127.0.0.1 (artinya "komputer ini sendiri"). Biarkan default.
# (Di dalam Docker nilai ini otomatis diarahkan ulang oleh docker-compose.yml.)
API_PROXY_HOST=127.0.0.1


# -----------------------------------------------------------------------------
# 5. BACKEND & DATABASE (apps/api + service `db`)
# -----------------------------------------------------------------------------
# Database = tempat menyimpan data. Bagian ini seperti "kunci rumah" database.
# Untuk pemakaian lokal, nilai contoh di bawah sudah cukup.

# Alamat dan nomor pintu database. Untuk lokal, biarkan default.
DB_HOST=127.0.0.1
DB_PORT=3306

# Nama database dan nama pengguna yang dipakai aplikasi.
DB_NAME=ishas
DB_USER=ishas

# Kata sandi database. WAJIB diganti bila dipakai di server sungguhan!
# Contoh: DB_PASSWORD=gantiSandiKUat123
DB_PASSWORD=ishas

# Kata sandi akun "root" (admin tertinggi) database. Ganti bila untuk produksi.
DB_ROOT_PASSWORD=root

# Tempat menyimpan berkas unggahan (gambar/dokumen).
# Kosongkan = otomatis memakai folder `storage` bawaan. Biarkan kosong.
STORAGE_DIR=


# -----------------------------------------------------------------------------
# 6. LOGIN & KEAMANAN (Auth, Fase 6)
# -----------------------------------------------------------------------------
# Pengaturan seputar masuk akun dan pembatasan percobaan login.

# Kata sandi awal untuk akun contoh (seed). Hanya untuk prototipe.
# WAJIB diganti di server sungguhan. Contoh: SEED_DEFAULT_PASSWORD=Sandi#Awal2026
SEED_DEFAULT_PASSWORD=ishas-demo

# Lama sesi login bertahan, dalam milidetik (ms).
# 604800000 ms = 7 hari. Contoh 1 hari: SESSION_TTL_MS=86400000
SESSION_TTL_MS=604800000

# Batas jumlah percobaan login gagal sebelum diblokir sementara.
# Contoh: LOGIN_RATE_LIMIT=5  (artinya maksimal 5 kali per jendela waktu)
LOGIN_RATE_LIMIT=5

# Jendela waktu pembatasan di atas, dalam milidetik.
# 60000 ms = 60 detik. Contoh 5 menit: LOGIN_RATE_WINDOW_MS=300000
LOGIN_RATE_WINDOW_MS=60000

# Kartu login demo (satu klik, tanpa sandi). Hanya untuk pengembangan.
#   true  = tampilkan kartu demo di /login (cocok untuk ngoding)
#   false = sembunyikan kartu; login memakai email + sandi (untuk rilis)
# Di Docker, nilai ini DIABAIKAN: profile `dev` menyalakannya dan profile
# `prod` mematikannya otomatis. Setel hanya bila menjalankan backend langsung.
# DEMO_AUTH_ENABLED=true

# Tandai cookie sesi sebagai "Secure" (hanya dikirim lewat HTTPS).
#   false = prototipe lokal via http://localhost (bawaan)
#   true  = WAJIB bila aplikasi sudah diakses lewat HTTPS
COOKIE_SECURE=false


# -----------------------------------------------------------------------------
# 7. HOSTING (Cloudflare Tunnel / reverse proxy)
# -----------------------------------------------------------------------------
# Arsitektur BAWAAN: satu domain (mis. https://ishas.utc.web.id) — frontend dan
# /api dilayani service `web-prod` (nginx). Cocok untuk Cloudflare Tunnel:
# arahkan satu public hostname ke http://localhost:3003. Biarkan dua nilai
# CORS/COOKIE_DOMAIN di bawah KOSONG untuk mode ini.
#
# Hanya bila backend dipisah ke subdomain lain (mis. api-ishas.utc.web.id):
#   - isi CORS_ALLOWED_ORIGINS + COOKIE_DOMAIN di bawah,
#   - arahkan hostname API ke http://localhost:3004,
#   - rebuild frontend dengan VITE_API_BASE absolut.
# Lihat docs/DEPLOYMENT_CLOUDFLARE_TUNNEL.md.
#
# Origin frontend yang diizinkan mengakses API (dipisah koma). Kosong = tanpa CORS.
# CORS_ALLOWED_ORIGINS=https://ishas.utc.web.id
#
# Domain cookie (mis. `.utc.web.id`) agar cookie CSRF terbaca JS frontend saat
# backend di subdomain terpisah. Kosong = host-only (satu domain).
# COOKIE_DOMAIN=.utc.web.id

# Token Cloudflare Tunnel (opsional) bila ingin menjalankan `cloudflared`
# sebagai service Docker. Dapat dari Zero Trust → Networks → Tunnels.
# CLOUDFLARE_TUNNEL_TOKEN=
